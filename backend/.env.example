# Backend environment variables

# Database connection URL
# IMPORTANT: Do NOT use the PostgreSQL superuser (postgres) role for normal application connections.
# Row-Level Security (RLS) policies are bypassed for superuser connections by PostgreSQL design.
# Instead, create a dedicated application role with limited privileges.
#
# Create the role once in your local Postgres instance:
#   CREATE ROLE app_user WITH LOGIN PASSWORD 'app_password';
#   GRANT CONNECT ON DATABASE rfp_response TO app_user;
#   GRANT USAGE ON SCHEMA public TO app_user;
#   GRANT CREATE ON SCHEMA public TO app_user;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_user;
#
# Then use this URL:
# DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/rfp_response
#
# For development convenience, you may temporarily use the superuser for testing,
# but be aware that RLS will not be enforced in that case.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/rfp_response

# Environment (development, staging, production)
ENV=development

# Redis connection (for task queue and caching)
REDIS_URL=redis://localhost:6379/0

# MinIO connection (for document storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rfp-documents

# API configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
