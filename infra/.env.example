# Application
# Runtime environment (development, test, staging, production).
APP_ENV=development

# Frontend
# Public URL for the API, including its /api/v1 prefix (for example http://localhost:8000/api/v1).
VITE_API_BASE_URL=

# Database
# PostgreSQL connection string used by the backend.
DATABASE_URL=

# Redis
# Redis connection string used for caching and asynchronous work.
REDIS_URL=

# S3-compatible object storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# OpenID Connect
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# LLM provider
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_DEFAULT_MODEL=
