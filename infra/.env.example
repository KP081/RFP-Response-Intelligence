# Application
# Runtime environment (development, test, staging, production).
APP_ENV=development
# Minimum structured-log severity.
LOG_LEVEL=INFO

# Frontend
# Public API URL, including its /api/v1 prefix. The browser reaches Docker through localhost.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database
# PostgreSQL connection string used by the backend inside the Compose network.
# Uses a non-superuser role so Row-Level Security is actually enforced — do not point this
# at the `postgres` superuser role, which bypasses RLS regardless of FORCE ROW LEVEL SECURITY.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/rfp_response
# Superuser connection string, used only by Alembic migrations and the seed script.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rfp_response

# Redis
# Redis connection string used for caching and asynchronous work inside the Compose network.
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage
# MinIO endpoint used by application containers inside the Compose network.
S3_ENDPOINT=http://minio:9000
# Bucket created automatically by the minio-init service.
S3_BUCKET=rfp-response-intelligence
# Local-only MinIO credentials. Never use these outside local development.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# OpenID Connect (Keycloak for local dev)
# Keycloak issuer URL for the realm.
OIDC_ISSUER=http://localhost:8081/realms/rfp-response-intelligence
# Client ID configured in Keycloak.
OIDC_CLIENT_ID=rfp-response-intelligence-web
# Client secret configured in Keycloak.
OIDC_CLIENT_SECRET=local-development-only
# Fixed OAuth callback URL the backend itself exposes — this is what must be registered as a
# Valid Redirect URI in Keycloak. This is NOT a frontend URL; the backend receives the
# authorization code directly and exchanges it server-side (see auth/router.py callback()).
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# JWT Configuration
# Secret key for signing JWT tokens. MUST be changed in production!
JWT_SECRET_KEY=dev-secret-change-in-production
# Algorithm for JWT signing.
JWT_ALGORITHM=HS256
# Access token expiry in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token expiry in days.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# LLM provider
# Provider to use: "openai" or "mock" (for local development without API key).
LLM_PROVIDER=mock
# API key for the LLM provider. Required for "openai".
LLM_API_KEY=not-used-in-local-development
# Model tier mappings (provider-specific model names).
# Fast model for classification/extraction tasks.
LLM_DEFAULT_MODEL_FAST=gpt-4o-mini
# Reasoning model for drafting/risk judgment tasks.
LLM_DEFAULT_MODEL_REASONING=gpt-4o
# Vision model for figure captioning/image analysis tasks.
LLM_DEFAULT_MODEL_VISION=gpt-4o
# Cache TTL in seconds (default: 24 hours).
LLM_CACHE_TTL_SECONDS=86400
