# Application
# Runtime environment (development, test, staging, production).
APP_ENV=development
# Minimum structured-log severity.
LOG_LEVEL=INFO

# Frontend
# Public API URL, including its /api/v1 prefix. The browser reaches Docker through localhost.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database
# PostgreSQL connection string used by the backend inside the Compose network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rfp_response

# Redis
# Redis connection string used for caching and asynchronous work inside the Compose network.
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage
# MinIO endpoint used by application containers inside the Compose network.
S3_ENDPOINT=http://minio:9000
# Bucket created automatically by the minio-init service.
S3_BUCKET=rfp-response-intelligence
# Local-only MinIO credentials. Never use these outside local development.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# OpenID Connect
# Safe local placeholders until the identity-provider integration is added.
OIDC_ISSUER=http://localhost:8081/realms/rfp-response-intelligence
OIDC_CLIENT_ID=rfp-response-intelligence-web
OIDC_CLIENT_SECRET=local-development-only

# LLM provider
# Safe local placeholders until an LLM integration is added.
LLM_PROVIDER=mock
LLM_API_KEY=not-used-in-local-development
LLM_DEFAULT_MODEL=mock-model
